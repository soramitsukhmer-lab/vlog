<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application>
        <service android:name="com.android.girish.vlog.VlogService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the Vlog log overlay bubble alive while the app is in the background"/>
        </service>

        <!-- Expanded content of the notification bubble mode -->
        <activity android:name="com.android.girish.vlog.VlogBubbleActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:exported="false"/>

        <receiver android:name="com.android.girish.vlog.VlogBubbleDismissReceiver"
            android:exported="false"/>
    </application>
</manifest>
